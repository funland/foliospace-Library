# Docker image and host port
FOLIOSPACE_IMAGE=funland/foliospace-library:1.02
FOLIOSPACE_CONTAINER_NAME=foliospace-library
FOLIOSPACE_PORT=8080

# Persistent writable service data. Back up this directory before upgrades.
FOLIOSPACE_CONFIG_PATH=./data/config

# Host media directories. The container mounts all media read-only.
FOLIOSPACE_LIBRARY_PATH=./data/library
FOLIOSPACE_BOOKS_PATH=./data/books
FOLIOSPACE_GAMES_PATH=./data/games
FOLIOSPACE_VIDEOS_PATH=./data/videos

# Optional fixed API token. Leave empty to create the first token in web setup.
# Tokens must contain at least 8 characters.
FOLIOSPACE_API_TOKEN=

# Resource controls for Mac, Windows, Linux, or NAS Docker hosts
FOLIOSPACE_SCAN_WORKERS=2
FOLIOSPACE_MEMORY_LIMIT_MB=768
FOLIOSPACE_CONTAINER_MEMORY_LIMIT=1536m
